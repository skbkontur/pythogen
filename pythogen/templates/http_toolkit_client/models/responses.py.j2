{%- include 'models/!imports.j2' %}

{% if enums %}
from {{ import_path }}.models.enums import (
    {% for enum_class in enums %}
    {{ classname(enum_class.id) }},
    {% endfor %}
)
{% endif %}

__all__ = [
    {% for model in models %}
        {%- if model.type == Type.null  %}
        {%- elif model.is_empty_object  %}
        {%- elif model.all_of %}
        {%- elif model.any_of %}
        {%- elif model.one_of %}
        {%- else %}
        "{{ classname(model.id) }}",
        {%- endif %}
    {% endfor %}
]

class BaseConfig:
    model_config = ConfigDict(
        validate_by_name=True,
        validate_by_alias=True,
    )


{%- for model in models %}

{%- if model.type == Type.null  %}
{%- elif model.is_empty_object  %}

class {{ classname(model.id) }}(BaseModel, BaseConfig):
    {%- for doc_line in wrap_lines(docstring_lines(model), maxlength=line_length - 4) %}
    {{ doc_line }}
    {%- endfor %}
    ...
{%- elif model.any_of %}

class {{ classname(model.id) }}(RootModel):
    {%- for doc_line in wrap_lines(docstring_lines(model), maxlength=line_length - 4) %}
    {{ doc_line }}
    {%- endfor %}
    root: {{ repranyof(model.any_of, document) }}
{%- elif model.one_of %}

class {{ classname(model.id) }}(RootModel):
    {%- for doc_line in wrap_lines(docstring_lines(model), maxlength=line_length - 4) %}
    {{ doc_line }}
    {%- endfor %}
    root: {{ repranyof(model.one_of, document) }}
{%- elif model.all_of %}

class {{ classname(model.id) }}(
    {%- for part in model.all_of %}
    {{ classname(part.id) }}{{ ", " if not loop.last else "" }}
    {%- endfor %}, BaseConfig
):
    {%- for doc_line in wrap_lines(docstring_lines(model), maxlength=line_length - 4) %}
    {{ doc_line }}
    {%- endfor %}
    {%- for property in model.required_properties %}
    {%- if property.schema.is_nullable %}
    {{ property.key }}: {{ typerepr(property.schema, document, True) }} | None {{ propertyfield(property, model) }}
    {%- else %}
    {{ property.key }}: {{ typerepr(property.schema, document, True) }} {{ propertyfield(property, model) }}
    {%- endif %}
    {%- endfor -%}
    {%- for property in model.optional_properties %}
    {%- if property.schema.is_nullable %}
    {{ property.key }}: {{ typerepr(property.schema, document, True) }} | MISSING | None {{ propertyfield(property, model) }}
    {%- else %}
    {{ property.key }}: {{ typerepr(property.schema, document, True) }} | MISSING {{ propertyfield(property, model) }}
    {%- endif %}
    {%- endfor -%}

    {% for property in model.required_properties + model.optional_properties if property.safety_key %}
    {%- break %}
    {%- endfor %}
    {%- if not model.properties %}
    ...
    {% endif %}
{%- else %}

class {{ classname(model.id) }}(BaseModel, BaseConfig):
    {%- for doc_line in wrap_lines(docstring_lines(model), maxlength=line_length - 4) %}
    {{ doc_line }}
    {%- endfor %}
    {%- for property in model.required_properties %}
    {%- if property.schema.is_nullable %}
    {{ property.key }}: {{ typerepr(property.schema, document, True) }} | None {{ propertyfield(property, model) }}
    {%- else %}
    {{ property.key }}: {{ typerepr(property.schema, document, True) }} {{ propertyfield(property, model) }}
    {%- endif %}
    {%- endfor -%}
    {%- for property in model.optional_properties %}
    {%- if property.schema.is_nullable %}
    {{ property.key }}: {{ typerepr(property.schema, document, True) }} | MISSING | None {{ propertyfield(property, model) }}
    {%- else %}
    {{ property.key }}: {{ typerepr(property.schema, document, True) }} | MISSING {{ propertyfield(property, model) }}
    {%- endif %}
    {%- endfor -%}

    {% for property in model.required_properties + model.optional_properties if property.safety_key %}
    {%- break %}
    {%- endfor %}
    {%- if model.is_empty_properties %}
    ...
    {% endif %}
{% endif %}

{%- endfor %}
